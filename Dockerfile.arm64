FROM debian:bullseye-slim
ENV DEBIAN_FRONTEND=noninteractive

RUN echo 'APT::Get::Assume-Yes "true";' >> /etc/apt/apt.conf
RUN apt-get update

RUN apt-get install build-essential zip unzip curl \
    flex bison zlib1g-dev libexpat-dev \
    python3 python3-dev libpython3-dev python3-pip \
    swig patchelf autotools-dev

RUN pip3 install --upgrade pip setuptools flit_core

WORKDIR /tmp

# Download pynusmv
RUN curl -L -o pynusmv.zip https://github.com/LouvainVerificationLab/pynusmv/archive/refs/heads/master.zip && \
    unzip pynusmv.zip

# Patch for aarch64: pre-extract the NuSMV tarball, replace ancient config.guess/config.sub,
# and touch the marker so the Makefile skips re-extraction
RUN cd pynusmv-master/dependencies/NuSMV && \
    tar xzf NuSMV-2.5.4.tar.gz && \
    find NuSMV-2.5.4 -name config.guess -exec cp /usr/share/misc/config.guess {} \; && \
    find NuSMV-2.5.4 -name config.sub -exec cp /usr/share/misc/config.sub {} \; && \
    touch nusmv.unpacked

# Patch the NuSMV Makefile's configure call to pass --build for aarch64
RUN cd pynusmv-master/dependencies/NuSMV && \
    sed -i "s|./configure|./configure --build=$(uname -m)-unknown-linux-gnu|" Makefile

# Build and install pynusmv (--no-build-isolation so it uses the patched source in-place)
RUN cd pynusmv-master && pip3 install --no-build-isolation .

# Now install the actual project
WORKDIR /usr/local/src
COPY requirements.txt .
COPY . evidential-calculator
RUN cd evidential-calculator && pip3 install .

WORKDIR /data
CMD ["calc_evidence.py"]
